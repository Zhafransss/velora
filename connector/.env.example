# Connector listens on localhost only. Never expose it to the internet.
CONNECTOR_HOST=127.0.0.1
CONNECTOR_PORT=3100

# Shared secret between Laravel and the connector (Bearer token). Required.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTOR_TOKEN=

# Where auth state is stored (creds + Signal keys, one folder per channel).
# MUST be outside the web root and included in backups. Default: ./auth
AUTH_DIR=./auth

# Optional: Laravel endpoint that receives inbound messages (signed with HMAC-SHA256).
# Leave empty during PoC to only log inbound messages.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Reconnect policy (exponential backoff with jitter)
RECONNECT_BASE_MS=2000
RECONNECT_MAX_MS=60000
RECONNECT_MAX_ATTEMPTS=10

# Outbound pacing per channel (ban mitigation): random delay before each send,
# plus a minimum gap between two sends on the same channel.
SEND_DELAY_MIN_MS=1500
SEND_DELAY_MAX_MS=4000
SEND_MIN_GAP_MS=2000

LOG_LEVEL=info
