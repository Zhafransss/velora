# Connector listens on localhost only. Never expose it to the internet.
CONNECTOR_HOST=127.0.0.1
CONNECTOR_PORT=3100

# Shared secret between Laravel and the connector (Bearer token). Required.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTOR_TOKEN=

# Penyimpanan auth WhatsApp (creds + kunci Signal) — DEC-17.
#   mysql : TERENKRIPSI AES-256-GCM di MySQL (tabel wa_auth_creds/wa_auth_keys dari migrasi Laravel). UNTUK PRODUKSI.
#   file  : folder AUTH_DIR per channel, TANPA enkripsi. Hanya PoC/pengembangan. Default.
AUTH_STORE=file
AUTH_DIR=./auth

# Hanya untuk AUTH_STORE=mysql. Pakai pengguna MySQL khusus dengan hak minimal (lihat README).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Kunci enkripsi auth: "<id>:<base64 32 byte>[,<id2>:<base64>]". Kunci PERTAMA menulis, semua kunci bisa membaca (rotasi).
# Buat: npm run keygen
# PENTING: cadangkan kunci ini TERPISAH dari backup database (mis. password manager). Kunci hilang = semua sesi WhatsApp
# tidak terbaca dan semua nomor harus scan QR ulang. Jangan di-commit.
AUTH_ENCRYPTION_KEYS=

# Optional: Laravel endpoint that receives inbound messages (signed with HMAC-SHA256).
# Leave empty during PoC to only log inbound messages.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Reconnect policy (exponential backoff with jitter)
RECONNECT_BASE_MS=2000
RECONNECT_MAX_MS=60000
RECONNECT_MAX_ATTEMPTS=10

# Outbound pacing per channel (ban mitigation): random delay before each send,
# plus a minimum gap between two sends on the same channel.
SEND_DELAY_MIN_MS=1500
SEND_DELAY_MAX_MS=4000
SEND_MIN_GAP_MS=2000

LOG_LEVEL=info
