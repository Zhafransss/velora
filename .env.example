APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Produksi: LOG_LEVEL=info (atau hapus baris ini; default produksi = info). debug hanya untuk lokal.
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=veloradigital
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Biarkan dikomentari = cookie sesi otomatis Secure untuk request HTTPS (jangan isi string kosong). Isi true bila TLS diakhiri proxy
# (mis. Cloudflare mode Flexible) sehingga aplikasi melihat request sebagai HTTP.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Gambar konten website (upload admin). public = storage/app/public; r2 = Cloudflare R2.
# Urutan pindah ke R2: isi R2_* -> php artisan media:check r2 -> php artisan media:sync --to=r2 -> MEDIA_DISK=r2.
# Lihat docs/DEPLOY-CHECKLIST.md bagian 6.
MEDIA_DISK=public
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# URL publik bucket, tanpa garis miring di akhir (domain kustom atau https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=

VITE_APP_NAME="${APP_NAME}"

# --- AI gateway (FR-007): secret HANYA di server, jangan di-commit ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_PROVIDER_ORDER=gemini,groq
AI_MAX_OUTPUT_TOKENS=1024
# Opsional: batasi "berpikir" model agar jawaban tidak terpotong dan lebih cepat/murah
GEMINI_THINKING_LEVEL=
GROQ_REASONING_EFFORT=
AI_RETRIES=1
AI_BUDGET_SECONDS=45

# --- Konektor WhatsApp (Baileys) — FR-009: secret hanya di server ---
CONNECTOR_URL=http://127.0.0.1:3100
CONNECTOR_TOKEN=
CONNECTOR_WEBHOOK_SECRET=

# --- Email (Hostinger SMTP). MAIL_PASSWORD = password mailbox team@veloradigitalworks.com, hanya di .env server ---
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=team@veloradigitalworks.com
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="team@veloradigitalworks.com"
# MAIL_FROM_NAME="Velora Digital"
# MAIL_EHLO_DOMAIN=veloradigitalworks.com   # wajib di lokal bila APP_URL=http://127.0.0.1:8000
# MAIL_TIMEOUT=10   # detik; bawaan 10. Banyak ISP rumahan (mis. ICONNET) memblokir port SMTP keluar:
#                   # di komputer lokal pakai MAIL_MAILER=log (email + tautan ditulis ke storage/logs/laravel.log).
# Indikator "sedang mengetik" ke pelanggan selama AI bekerja (default: true)
# WHATSAPP_TYPING_INDICATOR=true
# reCAPTCHA v2 (form daftar & kontak). Produksi: RECAPTCHA_ENABLED=true dengan kunci dari Google reCAPTCHA Admin.
# Daftarkan domain veloradigitalworks.com pada key. Matikan hanya untuk pengembangan lokal tanpa key.
# RECAPTCHA_ENABLED=true
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# Backup database terenkripsi (NFR-005) — lihat docs/BACKUP-RESTORE.md
# BACKUP_ENCRYPTION_KEY=          # php artisan backup:key ; cadangkan di password manager, terpisah dari backup
# BACKUP_S3_BUCKET=               # penyimpanan DI LUAR server (Cloudflare R2 / Backblaze B2 / S3)
# BACKUP_S3_KEY=
# BACKUP_S3_SECRET=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=auto
# BACKUP_VERIFY_DATABASE=veloradigital_restore_check
# BACKUP_RETENTION_DAYS=14        # maksimal 30 (DEC-15)
